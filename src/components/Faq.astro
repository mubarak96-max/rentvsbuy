---
interface Props { faqs: { q: string; a: string }[]; heading?: string }
const { faqs, heading = 'Frequently asked questions' } = Astro.props;
---
{faqs.length > 0 && (
  <section class="faq" aria-labelledby="faq-h">
    <h2 id="faq-h">{heading}</h2>
    {faqs.map((f, i) => (
      <details open={i === 0}>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </section>
)}
